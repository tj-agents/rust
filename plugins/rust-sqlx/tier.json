{
  "tier": "rust-sqlx",
  "stack": "Rust SQLx",
  "applies": "stack-present",
  "detect": {
    "any": [
      {
        "content": {
          "glob": "Cargo.toml",
          "pattern": "(?m)^\\s*sqlx\\s*=|\\[.*dependencies\\.sqlx\\]"
        }
      },
      {
        "remote": "^tj\\-agents/rust$"
      }
    ]
  }
}
