{
  "schema_version": 3,
  "tier": "tauri",
  "stack": "Tauri 2",
  "applies": "stack-present",
  "owner_repository": [
    "tj-agents/rust"
  ],
  "detect": {
    "any": [
      {
        "content": {
          "glob": "tauri.conf.json*",
          "pattern": "https://schema\\.tauri\\.app/config/2\\b"
        }
      },
      {
        "content": {
          "glob": "Cargo.toml",
          "pattern": "(?ms)^\\s*tauri\\s*=\\s*(?:[\"']\\s*[~^=]?\\s*2(?:\\.|[\"'])|\\{[^\\r\\n}]*\\bversion\\s*=\\s*[\"']\\s*[~^=]?\\s*2(?:\\.|[\"']))|^\\s*\\[(?:workspace\\.)?(?:dependencies|dev-dependencies|build-dependencies)\\.tauri\\]\\s*\\n(?:(?!^\\s*\\[).)*?^\\s*version\\s*=\\s*[\"']\\s*[~^=]?\\s*2(?:\\.|[\"'])"
        }
      }
    ]
  },
  "routes": [
    {
      "path": "(^|/)(src-tauri/)?(tauri\\.conf\\.json5?|Tauri\\.toml|build\\.rs)$",
      "skills": [
        "tauri:structure",
        "tauri:commands"
      ]
    },
    {
      "path": "\\.(rs|[jt]sx?|json|toml)$",
      "content_requires": "tauri::|@tauri-apps/|\"permissions\"\\s*:",
      "skills": [
        "tauri:commands"
      ]
    },
    {
      "path": "(^|/)src-tauri/(capabilities|permissions)/",
      "skills": [
        "tauri:commands"
      ]
    },
    {
      "path": "\\.rs$",
      "content_requires": "\\.manage\\(|generate_handler!",
      "skills": [
        "tauri:structure"
      ]
    }
  ]
}
